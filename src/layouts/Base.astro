---
import { Font } from 'astro:assets';
import '../styles/global.css';
import BuildHud from '../components/hud/BuildHud.astro';
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Solo la home se construye: en una página interna el visitante viene a leer. */
  build?: boolean;
  /** Ruta sin prefijo de idioma, para canonical y hreflang. `null` en páginas sin par. */
  path?: string | null;
  /** Imagen para compartir, en `public/og/`. */
  og?: string;
}

const { lang, build = true, path = '/', og = `home-${lang}` } = Astro.props;
const t = ui[lang];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const site = Astro.site;
const urlFor = (l: Lang, p: string): string => {
  const local = l === 'es' ? p : `/en${p}`;
  return site ? new URL(local, site).href : local;
};
const ogImage = site ? new URL(`/og/${og}.png`, site).href : `/og/${og}.png`;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Renzo Payero',
  jobTitle: lang === 'es' ? 'Ingeniero en Sistemas' : 'Systems Engineer',
  email: 'mailto:rpayerodev@gmail.com',
  address: { '@type': 'PostalAddress', addressLocality: 'Rosario', addressRegion: 'Santa Fe', addressCountry: 'AR' },
  sameAs: ['https://www.linkedin.com/in/renzopayero/', 'https://dakodev.com/'],
  worksFor: { '@type': 'Organization', name: 'Dakodev', url: 'https://dakodev.com/' },
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b070a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {path !== null && <link rel="canonical" href={urlFor(lang, path)} />}
    {path !== null && <link rel="alternate" hreflang="es" href={urlFor('es', path)} />}
    {path !== null && <link rel="alternate" hreflang="en" href={urlFor('en', path)} />}
    {path !== null && <link rel="alternate" hreflang="x-default" href={urlFor('es', path)} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_AR' : 'en_US'} />
    {path !== null && <meta property="og:url" content={urlFor(lang, path)} />}
    <meta name="twitter:card" content="summary_large_image" />
    {path === '/' && <script type="application/ld+json" set:html={JSON.stringify(person)} />}
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-geist" />
    <!--
      Decide antes del primer pintado si corre el build. Sin JS o con reduced motion
      la página llega en su estado final. Si el motor no carga, el watchdog la libera.
    -->
    <script is:inline define:vars={{ build }}>
      (function () {
        var root = document.documentElement;
        root.dataset.js = '';
        if (!build) return;
        var params = new URLSearchParams(location.search);
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        if (params.get('build') === '0') return;
        var WEEK = 6048e5;
        var seen = false;
        var replay = false;
        try {
          seen = Date.now() - Number(localStorage.getItem('rp-built') || 0) < WEEK;
          replay = sessionStorage.getItem('rp-replay') === '1';
          if (replay) {
            sessionStorage.removeItem('rp-replay');
            root.dataset.autopilot = '';
            history.scrollRestoration = 'manual';
          }
        } catch (e) {}
        if (seen && !replay && params.get('build') !== '1') return;
        root.dataset.build = 'pending';
        setTimeout(function () {
          if (root.dataset.build === 'pending') {
            root.dataset.build = 'off';
            dispatchEvent(new Event('rp:release'));
          }
        }, 3500);
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{t.skip}</a>
    {build && <BuildHud lang={lang} />}
    <slot />
    <script>
      import '../motion/reveal';
      import '../swarm/boot';
    </script>
  </body>
</html>

<style is:global>
  /* Transición nativa entre páginas: el video del proyecto viaja de la galería al caso. */
  @view-transition {
    navigation: auto;
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.32s;
    animation-timing-function: var(--ease-apple);
  }

  ::view-transition-group(*) {
    animation-duration: 0.5s;
    animation-timing-function: var(--ease-entrada);
  }

  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }

  .skip-link {
    position: fixed;
    top: 12px;
    left: 12px;
    z-index: 60;
    padding: 10px 16px;
    border-radius: 980px;
    background: var(--color-text);
    color: var(--color-bg);
    font-weight: 600;
    transform: translateY(-200%);
    transition: transform 0.32s var(--ease-apple);
  }

  .skip-link:focus-visible {
    transform: none;
  }
</style>
